# Claude powers HS classification, invoice extraction and the trade assistant.
# Leave empty to run with the offline (keyword/regex) engines.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Google Stitch MCP (UI design generation from Claude Code). Never commit the real key.
STITCH_API_KEY=

DATABASE_URL=sqlite:///./data/tradeflow.db
SEED_DEMO_DATA=true
